{
  "name": "from-islam-to-christ",
  "version": "0.2.28",
  "private": true,
  "type": "module",
  "description": "A private Bible-centered Electron and React prototype for From Islam to Christ.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build:data && node scripts/dev.cjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build": "npm run build:data && vite build",
    "build:data": "node scripts/build-data-index.cjs",
    "verify:database": "node scripts/verify-content-database.cjs",
    "verify:bible": "node scripts/verify-bible-navigation.cjs",
    "verify:audio": "node scripts/verify-audio-state.cjs",
    "verify:accessibility": "node scripts/verify-accessibility.cjs",
    "verify:links": "node scripts/verify-content-links.cjs",
    "verify:coverage": "node scripts/verify-source-coverage.cjs",
    "verify:word-study": "node scripts/verify-word-study.cjs",
    "verify:review": "node scripts/review-content-assets.cjs",
    "verify:privacy": "node scripts/verify-privacy-configuration.cjs",
    "verify:privacy:matrix": "node scripts/verify-privacy-state-matrix.cjs",
    "verify:updates": "node scripts/verify-update-safety.cjs",
    "verify:legal": "node scripts/verify-legal-information.cjs",
    "verify:licenses": "node scripts/verify-content-license-manifest.cjs",
    "verify:art": "node scripts/verify-section-art.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleDebug",
    "android:release": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.mcographics.fromdarknesstolight",
    "productName": "From Islam to Christ",
    "artifactName": "From-Islam-to-Christ-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "logo/**/*",
      "package.json"
    ],
    "win": {
      "icon": "logo/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "mcographics",
      "repo": "FromIslamtoChrist",
      "releaseType": "release"
    }
  }
}
